# ========================================
# Skypath Flow - Переменные окружения
# ========================================
# 
# Инструкция:
# 1. Скопируйте этот файл: cp .env.example .env
# 2. Заполните все переменные реальными значениями
# 3. НЕ коммитьте .env в Git!
#

# ========================================
# 🔥 Firebase Configuration
# ========================================
VITE_FIREBASE_API_KEY=AIzaSyC...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456
# Firebase Realtime Database (опционально). URL из консоли: Realtime Database → URL
# VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app

# ========================================
# 🖥️ 3x-ui Configuration
# ========================================
XUI_HOST=http://localhost:2053
XUI_USERNAME=admin
XUI_PASSWORD=your_password_here
XUI_INBOUND_ID=1

VITE_XUI_USERNAME=admin
VITE_XUI_PASSWORD=your_password_here
VITE_XUI_INBOUND_ID=1

# ========================================
# 🌐 Backend Proxy Server
# ========================================
# URL бэкенда для API (импорт NocoDB, админка и др.).
# Локально: http://localhost:5173 (через Vite proxy) или http://localhost:3001 (напрямую)
# Продакшн: https://skypath.fun или ваш домен
VITE_API_BASE_URL=http://localhost:5173

PROXY_PORT=3001
PROXY_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# ========================================
# 🔐 VLESS Configuration (опционально)
# ========================================
VITE_VLESS_SERVER=nl.skyputh.com
VITE_VLESS_PORT=443
VITE_VLESS_PUBLIC_KEY=your-public-key-here
VITE_VLESS_SHORT_ID=your-short-id-here
VITE_VLESS_SNI=www.microsoft.com
VITE_VLESS_FINGERPRINT=chrome

# ========================================
# 📱 Telegram Mini App (подсказка при входе не из Telegram)
# ========================================
# Username бота без @ — в сообщении «Откройте в Telegram» покажется ссылка https://t.me/<username>/app
# VITE_TELEGRAM_BOT_USERNAME=SkyflowBot

# ========================================
# 🛡️ Security & Logging
# ========================================
VITE_LOG_LEVEL=debug
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# ========================================
# 🚀 Environment
# ========================================
NODE_ENV=development
# ID приложения для путей Firestore. Должен совпадать с APP_ID в server/.env (иначе настройки платежей и данные не видны серверу).
# VITE_APP_ID=skypathvpn

# Email админов (доступ к админ-панели). Через запятую. vladislav4endev@gmail.com всегда включён.
# VITE_ADMIN_EMAILS=vladislav4endev@gmail.com,admin@example.com
