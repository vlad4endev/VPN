# ========================================
# 🔐 СЕКРЕТЫ И ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ========================================

# Environment files - ВСЕ версии .env файлов
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Исключения: можно коммитить только шаблоны
!.env.example
!.env.development.example

# Server environment files
server/.env
server/.env.local
server/.env.*.local
!server/.env.example

# Firebase service account key (секретный ключ — не коммитить)
server/firebase-service-account.json

# Локальные настройки Platega (только на сервере, никуда не передаются)
server/data/platega-settings.json

# ========================================
# 🚨 КРИТИЧНО: Секреты в коде
# ========================================

# Файлы со скриптами обновления секретов (если содержат секреты)
update_firebase_env.py
*_secrets.py
*_keys.py

# ========================================
# 📦 DEPENDENCIES
# ========================================

node_modules
/.pnp
.pnp.js

# ========================================
# 🧪 TESTING
# ========================================

/coverage

# ========================================
# 🏗️ PRODUCTION BUILD
# ========================================

/build
/dist

# ========================================
