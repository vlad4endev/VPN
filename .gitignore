.docker-secrets/
docker-secrets.txt
secrets/
!secrets/.gitkeep

# ========================================
# 📦 BACKUP & ARCHIVE
# ========================================

*.zip
*.tar.gz
Бекап*.zip
backup*.zip
*.backup
.env.backup
# Папки с бэкапами (могут содержать скомпилированные файлы с секретами)
Бекап*/
backup*/
**/Бекап*/
**/backup*/
