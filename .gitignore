# ========================================

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend.log
frontend.log

# PID files
*.pid
.backend.pid
.frontend.pid

# ========================================
# 💻 EDITOR & IDE
# ========================================

.DS_Store
.vscode
.idea
.cursor
*.swp
*.swo
*~

