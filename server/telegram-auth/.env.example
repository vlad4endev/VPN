# Telegram Auth API — гибридная авторизация через Telegram

# Порт (при запуске server.js)
PORT=3002

# PostgreSQL (обязательно)
DATABASE_URL=postgresql://user:password@localhost:5432/vpndb

# Redis (обязательно, один refresh на пользователя)
REDIS_URL=redis://localhost:6379

# Токен бота от @BotFather (для проверки подписи и уведомлений о новом устройстве)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Секрет для подписи JWT (минимум 32 символа)
JWT_SECRET=your-very-long-secret-at-least-32-chars

# Домен для httpOnly cookie (например skypath.fun). Не задавать — cookie без domain.
# COOKIE_DOMAIN=skypath.fun

# Secure для cookie (true в production по HTTPS)
COOKIE_SECURE=false
