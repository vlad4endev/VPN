# ============================================
# Telegram Bot (Webhook) — конфигурация
# ============================================

# Обязательно: токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...

# Секрет для проверки webhook (X-Telegram-Bot-Api-Secret-Token). Рекомендуется в production.
TELEGRAM_WEBHOOK_SECRET=your-random-secret-key

# Публичный URL приложения (HTTPS). Нужен для setWebhook.
PUBLIC_URL=https://your-domain.com

# Rate limiting: окно в мс и макс. запросов за окно
TELEGRAM_RATE_LIMIT_WINDOW_MS=60000
TELEGRAM_RATE_LIMIT_MAX=30

# Telegram API: таймаут и retry при отправке сообщений
TELEGRAM_API_TIMEOUT_MS=10000
TELEGRAM_SEND_RETRY_ATTEMPTS=3
TELEGRAM_SEND_RETRY_DELAY_MS=500

# Хранилище состояний: memory | redis | postgres
TELEGRAM_STATE_STORE=memory

# Redis (если TELEGRAM_STATE_STORE=redis)
REDIS_URL=redis://localhost:6379
TELEGRAM_REDIS_PREFIX=tg_bot:
TELEGRAM_STATE_TTL_SECONDS=3600

# PostgreSQL (если TELEGRAM_STATE_STORE=postgres)
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# Логирование событий пользователей в БД (true/false)
TELEGRAM_USER_LOG_ENABLED=false
TELEGRAM_USER_LOG_TABLE=telegram_user_events
