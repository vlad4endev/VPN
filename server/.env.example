# ========================================
# 🔐 BACKEND SERVER SECRETS
# ========================================
# ⚠️ КРИТИЧНО: Эти секреты НЕ должны попадать в клиентский код!

# 3x-ui Configuration
# XUI_HOST — базовый URL панели (с Random Path при необходимости).
# Примеры: http://localhost:2053   https://84.201.161.204:40919/Gxckr4KcZGtB6aOZdw
XUI_HOST=http://localhost:2053
XUI_USERNAME=admin
XUI_PASSWORD=your_password_here
XUI_INBOUND_ID=1

# Server Configuration
NODE_ENV=development
PROXY_PORT=3001
PROXY_HOST=0.0.0.0

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ========================================
# 🧪 Локальный dev без Firebase Admin (только NODE_ENV !== production)
# ========================================
# ИИ-отчёт мониторинга: если запрос к :3001 с loopback (типично Vite proxy с localhost) и Firebase Admin не поднят — доступ без токена.
# С удалённой машины / при NODE_ENV=production — нужен Firebase Admin или общий секрет:
# MONITORING_AI_REPORT_DEV_SECRET=... и VITE_MONITORING_AI_REPORT_DEV_SECRET=... (корень проекта)

# ========================================
# 🔥 FIREBASE ADMIN (обязательно для публичных отзывов и платежей)
# ========================================
# Без этих переменных: «Сервис отзывов временно недоступен» и недоступны некоторые API.

# ID проекта Firebase (тот же, что во фронтенде)
FIREBASE_PROJECT_ID=your-project-id

# ========================================
# 🟢 SUPABASE (миграция и dual-write)
# ========================================
# URL проекта Supabase (Project Settings -> API -> Project URL)
# SUPABASE_URL=https://your-project-ref.supabase.co
# Service Role key (Project Settings -> API -> service_role)
# НИКОГДА не передавайте ключ в клиент и не коммитьте в git.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Вариант 1: JSON ключа сервисного аккаунта (одна строка)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"<contents of .pem>","client_email":"...","client_id":"...",...}

# Вариант 2: путь к JSON-файлу (положите ключ в server/firebase-service-account.json, файл в .gitignore)
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Вариант 3: отдельные переменные
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="<contents of service account .pem file>"

# ID приложения для путей Firestore (по умолчанию skyputh)
# APP_ID=skyputh

# ========================================
# 🎁 Реферальная программа (Firestore + опционально Supabase для resolve)
# ========================================
# Бонус пригласившему (баллы на referralBonusBalance). По умолчанию 100.
# REFERRAL_BONUS_AMOUNT=100
# Бонус приглашённому при регистрации по ссылке (0 = не начислять). Начисление атомарно в одной транзакции с бонусом пригласившему.
# REFERRAL_REFEREE_BONUS_AMOUNT=50

# ========================================
# 💳 PLATEGA (генерация платежей)
# ========================================
# Без этих переменных создаётся только заказ в Firestore (paymentUrl пустой).
# БЕЗОПАСНОСТЬ: Храните ключи в env или server/data/platega-settings.json (через админку).
# НЕ храните plategaSecretKey в Firestore public/settings — это утечка секрета.

# PLATEGA_MERCHANT_ID=6935052a-2f55-4986-b991-5e4c896e080d
# PLATEGA_SECRET_KEY=your-secret-key-from-platega
# Таймаут запроса к Platega API (мс). По умолчанию 30000 (30 с). При долгих ответах увеличьте.
# PLATEGA_REQUEST_TIMEOUT_MS=30000
# PAYMENT_DEBUG=true — расширенное логирование (строка для хеша YooMoney, payload Platega). Без логирования секретов.

# Опционально: список email через запятую — доступ к админ-API даже без role в Firestore (обход при 403)
# ADMIN_EMAILS=admin@example.com,second@example.com

# ========================================
# 📱 TELEGRAM BOT (уведомления, привязка аккаунта, напоминания об оплате)
# ========================================
# Токен бота от @BotFather. Без него привязка и уведомления в Telegram отключены.
# Используется TELEGRAM_BOT_TOKEN или TELEGRAM_TOKEN (если задан). Либо сохраните токен в админке (Интеграции → Telegram).
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Секрет: 1) для cron POST /api/telegram/send-reminders (X-Telegram-Secret);
# 2) для webhook — если задан, передаётся в setWebhook как secret_token (Telegram присылает X-Telegram-Bot-Api-Secret-Token).
# TELEGRAM_WEBHOOK_SECRET=your-secret

# Chat ID админа для уведомлений о новых тикетах поддержки (число или строка из @userinfobot).
# Можно также сохранить в Firestore: artifacts/APP_ID/public/settings.telegramAdminChatId
# TELEGRAM_ADMIN_CHAT_ID=123456789

# Базовый URL для setWebhook (HTTPS). Если задан — при нажатии «Webhook» в админке будет установлен URL https://<этот_хост>/api/telegram/webhook
# TELEGRAM_WEBHOOK_BASE_URL=https://skypath.fun
#
# CLI: зарегистрировать webhook в Telegram (тот же URL .../api/telegram/webhook):
#   cd server && npm run telegram:set-webhook
#   # или с явным доменом: npm run telegram:set-webhook -- https://example.com
# Текущий webhook: npm run telegram:webhook-status
# Диагностика (браузер): GET https://<ваш-домен>/api/telegram/ping — firestoreOk, botTokenConfigured, webhookSecretConfigured

# Удалённая проверка Telegram (B запрашивает проверку у A): если на этом инстансе нет TELEGRAM_BOT_TOKEN,
# но есть API-сервер с ботом (A), задайте URL эндпоинта проверки и общий секрет. A должен иметь TELEGRAM_VERIFY_SECRET в env.
# TELEGRAM_VERIFY_URL=https://bot.example.com
# TELEGRAM_VERIFY_SECRET=shared-secret-between-A-and-B
# TELEGRAM_VERIFY_TIMEOUT_MS=10000

# Таймаут HTTP к api.telegram.org (setWebhook, getWebhookInfo). По умолчанию 45000 мс.
# TELEGRAM_HTTP_TIMEOUT_MS=60000

# Бот — выдача ссылки подписки (🔑 Мой ключ VPN): базовый URL без завершающего /; к нему добавляется /{subId}.
# Если не задан — используется subscriptionLink тарифа, defaultSubscriptionLink в settings или дефолт из кода.
# VPN_SUBSCRIPTION_BASE_URL=https://subs.example.com:3458/vk198

# Новый клиент в 3x-ui из бота: лимит трафика в ГБ (0 = без ограничения по объёму в типичной конфигурации панели).
# TELEGRAM_BOT_DEFAULT_TOTAL_GB=0

# ========================================
# 🔔 WEB PUSH (уведомления о тикетах при закрытой вкладке)
# ========================================
# Сгенерировать: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_MAILTO=mailto:support@yourdomain.com

# ========================================
# 📊 NOCODB (импорт пользователей в админке)
# ========================================
# Опционально. Если заданы — в модалке «Импорт из NocoDB» можно не вводить их вручную.

# URL базы NocoDB (без слэша в конце), например https://app.nocodb.com
# NOCODB_BASE_URL=https://your-nocodb.domain

# API-токен из настроек NocoDB (Account / API Token)
# NOCODB_API_TOKEN=your-api-token

# ID таблицы (из URL таблицы в NocoDB, например mxxxxxxxx)
# NOCODB_TABLE_ID=mxxxxxxxx

# Пароль по умолчанию для импортируемых пользователей (минимум 6 символов). Можно задать в модалке.
# IMPORT_DEFAULT_PASSWORD=ChangeMe123

# ========================================
# 🤖 ИИ (провайдер выбирается в админке: Интеграции → ИИ)
# ========================================
# Один из ключей (или настройка в админке). Без ключа эндпоинты /api/ai/* возвращают 503.

# DeepSeek — https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# Qwen (Alibaba DashScope) — https://dashscope.console.aliyun.com/ — Qwen 3.5 Max и др.
# DASHSCOPE_API_KEY=sk-...
# Регион (опционально): dashscope-intl.aliyuncs.com (Singapore), dashscope-us.aliyuncs.com (US)
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# OpenRouter — https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Google Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
