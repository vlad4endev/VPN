{
  "appId": "fun.skypath.skyflow",
  "appName": "SKYFLOW",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "https://skypath.fun",
      "https://*.skypath.fun",
      "https://*.google.com",
      "https://*.googleapis.com",
      "https://*.firebaseapp.com",
      "https://*.firebaseio.com",
      "https://*.firebasestorage.googleapis.com",
      "https://*.telegram.org",
      "https://*.t.me",
      "https://mc.yandex.ru",
      "https://*.yandex.ru",
      "https://*.yandex.net",
      "https://*.oauth.yandex.ru",
      "capacitor://localhost",
      "http://localhost:*",
      "http://10.0.2.2:*",
      "http://127.0.0.1:*",
      "https://localhost:*"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#020617",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#020617"
  },
  "ios": {
    "contentInset": "automatic"
  }
}
