# Скопируйте в .env и подставьте реальные значения
DATABASE_URL="postgresql://user:password@localhost:5432/skyflow_referral?schema=public"

# Минимум 16 символов в production
SESSION_SECRET="change-me-to-a-long-random-string"

# Публичный URL приложения (для ссылки «Поделиться»)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Суммы отложенных бонусов (центы), Win–Win
REFERRAL_REWARD_REFERRER_CENTS=500
REFERRAL_REWARD_REFEREE_CENTS=200
